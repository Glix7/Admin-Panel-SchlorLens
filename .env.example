# ==============================================================================
# Scholar Lens — Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# Never commit actual secret values or .env files to Git.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Session Encryption Secret (Required for production cookie signing)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change_this_to_a_random_32_char_secret_in_production"

# Default Administrator Account (Seed credentials on fresh database initialization)
ADMIN_EMAIL="admin@scholarlens.edu"
ADMIN_PASSWORD="change_this_to_secure_password_in_production"

# Default Analyst / Viewer Account (Optional read-only access)
VIEWER_EMAIL="viewer@scholarlens.edu"
VIEWER_PASSWORD="change_this_to_secure_password_in_production"

# AI Studio / Cloud Run Environment (Injected automatically in cloud preview)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
